# Runtime environment variables for RetroSpace APOD Backend

# Core
NASA_API_KEY=DEMO_KEY
DATABASE_URL=sqlite+pysqlite:///./retrospace.db
PORT=3001

# CORS configuration
# Provide exact frontend origins as a comma-separated list.
# Include the QA environment and localhost for dev.
ALLOWED_ORIGINS=https://vscode-internal-29464-qa.qa01.cloud.kavia.ai:3000,http://localhost:3000,http://127.0.0.1:3000

# Optional legacy vars (still read if ALLOWED_ORIGINS not set)
REACT_APP_FRONTEND_URL=https://vscode-internal-29464-qa.qa01.cloud.kavia.ai:3000
REACT_APP_BACKEND_URL=http://localhost:3001
REACT_APP_API_BASE=http://localhost:3001/api
