# Backend environment variables example
# Copy to .env and adjust values as needed.

# NASA API key (falls back to DEMO_KEY if not provided)
NASA_API_KEY=DEMO_KEY

# Database URL (default is SQLite file in project directory)
# Examples:
#   SQLite file: sqlite:///./apod_cache.db
#   SQLite absolute: sqlite:////absolute/path/to/apod_cache.db
#   Postgres: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./apod_cache.db

# Port for FastAPI/uvicorn to listen on
PORT=3001

# Optional CORS-related variables
# REACT_APP_FRONTEND_URL=http://localhost:3000
# REACT_APP_BACKEND_URL=http://localhost:3001
# REACT_APP_API_BASE=http://localhost:3001
